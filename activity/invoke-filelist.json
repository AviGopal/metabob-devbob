{
  "id": "invoke-filelist",
  "name": "Invoke fileList resolver",
  "description": "A simple activity to invoke the fileList resolver and close the orphaned-capability-fileList gap.",
  "parameters": {
    "type": "object",
    "properties": {
      "dir": {
        "type": "string",
        "description": "The directory to list files from."
      },
      "recursive": {
        "type": "boolean",
        "description": "Whether to list files recursively."
      }
    },
    "required": ["dir", "recursive"]
  },
  "tasks": [
    {
      "id": "call-filelist",
      "resolver": "fileList",
      "input": {
        "dir": "{{dir}}",
        "recursive": "{{recursive}}"
      },
      "output": {
        "files": "{{body}}"
      }
    },
    {
      "id": "write-output",
      "resolver": "fs_write",
      "input": {
        "path": "/workspace/filelist_output.json",
        "content": "{{files | to_json}}"
      },
      "output": {}
    }
  ]
}