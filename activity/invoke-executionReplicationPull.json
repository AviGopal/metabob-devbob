
{
  "id": "invoke-executionReplicationPull",
  "name": "Invoke executionReplicationPull resolver",
  "description": "A simple activity to invoke the executionReplicationPull resolver and close the orphaned-capability-executionReplicationPull gap.",
  "parameters": {},
  "tasks": [
    {
      "id": "call-executionReplicationPull",
      "resolver": "executionReplicationPull",
      "input": {
        "config": {
          "type": "executionReplicationPull"
        }
      },
      "output": {
        "result": "{{body}}"
      }
    },
    {
      "id": "write-output",
      "resolver": "fs_write",
      "input": {
        "path": "/workspace/executionReplicationPull_output.json",
        "content": "{{result | to_json}}"
      },
      "output": {}
    }
  ]
}

